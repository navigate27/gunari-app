{
  "name": "gunari",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/@gunari/*"
  ],
  "scripts": {
    "dev": "next dev -p 7842",
    "build": "next build",
    "start": "next start -p 7842",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:golden:update": "UPDATE_GOLDEN=1 vitest run --config vitest.golden.config.ts",
    "smoke": "tsx packages/@gunari/scene-mapprint/scripts/smoke-render.ts",
    "stars": "node scripts/build-starcatalog.mjs",
    "milkyway": "node scripts/build-milkyway.mjs",
    "catalogs": "node scripts/build-starcatalog.mjs && node scripts/build-milkyway.mjs",
    "build:vercel": "npm run catalogs && next build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astronomy-engine": "^2.1.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "motion": "^11.15.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "canvas": "^3.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.10",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
